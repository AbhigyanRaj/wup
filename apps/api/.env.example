# wuup API configuration. Copy to .env and fill in. Values marked REQUIRED IN
# PRODUCTION make the server refuse to boot when NODE_ENV=production.

# ---- Server ----
# Runtime mode; "production" enables secure cookies and strict config checks
NODE_ENV=development
# HTTP port
PORT=4000
# Proxy hops to trust for client IPs (Render: 1)
TRUST_PROXY=1
# pino log level: fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
# Version reported by / and /health (defaults to package.json version)
# APP_VERSION=
# Session cookie and token lifetime in days
SESSION_TTL_DAYS=7
# Optional cookie domain; when set in production the cookie is __Secure-wuup_session instead of __Host-wuup_session
# COOKIE_DOMAIN=
# Keep auto-signup on POST /auth/login for the legacy web client
LEGACY_AUTO_SIGNUP=true

# ---- Database and secrets ----
# MongoDB connection string (REQUIRED IN PRODUCTION)
MONGODB_URI=mongodb://localhost:27017/wup
# JWT signing secret, 32+ random chars (REQUIRED IN PRODUCTION)
JWT_SECRET=replace_with_a_long_random_secret_of_32_chars_or_more
# Encryption key for stored credentials (REQUIRED IN PRODUCTION)
ENCRYPTION_KEY=replace_with_a_long_random_key
# Comma-separated old encryption keys, decrypt only (used during key rotation)
# ENCRYPTION_KEY_PREVIOUS=
# Comma-separated browser origins allowed to call the API (REQUIRED IN PRODUCTION, localhost is ignored there)
CORS_ORIGIN=http://localhost:3000

# ---- Models ----
# Server Gemini key for the free tier, embeddings and suggestions
GEMINI_API_KEY=your_gemini_api_key_here
# Comma-separated model ids the server key may use (empty = built-in default)
# SERVER_MODEL_ALLOWLIST=

# ---- Chat limits ----
# Free messages per user on the server key
FREE_TIER_LIMIT=50
# Maximum characters in one prompt
MAX_PROMPT_CHARS=8000
# Chat messages per minute per user
CHAT_RATE_LIMIT_PER_MIN=20

# ---- Web search ----
# Allow the model to search the web when asked
WEB_SEARCH_ENABLED=true

# ---- Research ----
# Enable deep research mode
RESEARCH_ENABLED=true
# Free-tier messages charged per research run
RESEARCH_COST=3
# Maximum research steps per run
RESEARCH_MAX_STEPS=5
# Research run timeout in milliseconds
RESEARCH_TIMEOUT_MS=180000

# ---- Google Sheets ----
# Service account JSON (inline); enables Sheets bridges
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Path to a service account JSON file (alternative to the inline value)
# GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/path/to/service-account.json

# ---- Sample bridge and demo ----
# Read-only sample MongoDB offered to new users and demo sessions
# SAMPLE_MONGODB_URI=
# Scope for the sample bridge, as JSON [{"db":"...","collections":["*"]}]
# SAMPLE_MONGODB_SCOPE=
# Allow anonymous demo sessions
DEMO_ENABLED=true
# Demo session lifetime in hours
DEMO_TTL_HOURS=24
# Messages allowed per demo session
DEMO_MESSAGE_LIMIT=15
# Maximum concurrent active demo users
DEMO_MAX_ACTIVE=500

# ---- Uploads and RAG ----
# Maximum upload size in MB
MAX_UPLOAD_SIZE_MB=20
# Maximum knowledge sources per user
MAX_SOURCES_PER_USER=20
# Maximum stored chunks per user
MAX_CHUNKS_PER_USER=5000
# Maximum chunks per uploaded file
MAX_CHUNKS_PER_FILE=500
# Uploads per hour per user
UPLOAD_RATE_LIMIT_PER_HOUR=10
# Parallel ingestion jobs per process
INGEST_CONCURRENCY=2
# Minimum cosine similarity for a retrieved chunk
RAG_MIN_COSINE=0.5
# Chunks retrieved per question
RAG_TOP_K=6

# ---- Bridges ----
# Allow bridges to private or loopback hosts (local development only; refused in production)
BRIDGE_ALLOW_PRIVATE_HOSTS=false
# Generate starter questions after a bridge schema scan
BRIDGE_SUGGESTIONS=true

# ---- Public tools (marketing site) ----
# Enable the free public tools under /public
PUBLIC_TOOLS_ENABLED=true
# Global daily cap on public tool runs
PUBLIC_TOOLS_DAILY_CAP=3000
# Model id used by public tools (empty = server default)
# PUBLIC_TOOLS_MODEL=
# Cloudflare Turnstile secret for public tool abuse protection
# TURNSTILE_SECRET_KEY=
